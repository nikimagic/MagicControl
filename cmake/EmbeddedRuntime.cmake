include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/PawnIORuntime.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/UniwillRuntime.cmake")
set(_pawn "${PROJECT_SOURCE_DIR}/src/platform/windows/runtime/PawnIO")
set(_uniwill "${PROJECT_SOURCE_DIR}/src/platform/windows/runtime/Uniwill")
set(_ami "${PROJECT_SOURCE_DIR}/src/platform/windows/runtime/AmiAfu")
set(_fpt "${PROJECT_SOURCE_DIR}/src/platform/windows/runtime/IntelFpt")
set(_fpt19 "${PROJECT_SOURCE_DIR}/src/platform/windows/runtime/IntelFpt19")
set(_nvflash "${PROJECT_SOURCE_DIR}/src/platform/windows/runtime/NvFlash")
set(_insyde "${PROJECT_SOURCE_DIR}/src/platform/windows/runtime/InsydeH2offt")
set(_lenovo_energy "${PROJECT_SOURCE_DIR}/src/platform/windows/runtime/LenovoEnergy")
file(SHA256 "${_lenovo_energy}/LenovoEnergySetup.exe" _lenovo_energy_hash)
if(NOT _lenovo_energy_hash STREQUAL "884163897dd3a8315f1984aa14862421f59e96e9ab7e11bb088124c7aa00989f")
    message(FATAL_ERROR "Official Lenovo Energy Management installer SHA256 mismatch")
endif()
# Official Lenovo KSCN43WW supplies signed Insyde6.76/SYS3.0.0.3. Use its
# complete reader set, without any Lenovo firmware input or obsolete6.25 DLLs.
# FlsHook is present for OEM validation only; fixed-g never launches it.
set(_insyde_files H2OFFT-Wx64.exe H2OFFT64.sys H2OFFT.cat H2OFFT.inf BiosImageProcx64.dll FlsHook.exe
    platform.ini NOTICE.txt PROVENANCE.json)
foreach(_pin IN ITEMS
    "H2OFFT-Wx64.exe|046514122b241581a61f7c3fda9e5d444b76de7f919efc89ab3ad2eb5d3a7de5"
    "H2OFFT64.sys|adac8f1ed5e46a8bcbdeb54e6ee08bf3695c65f2ab5e2b31cf1d438babf54463"
    "H2OFFT.cat|822055e3d0a6573d6604793aa1956de51ada3d7bc3c2893e128ce49e236d93d7"
    "H2OFFT.inf|d7f3704eead89858bc3058c569bdc0faa4d3909a423edcfb4fe733452215b875"
    "BiosImageProcx64.dll|e8587d0a603027915954588a4646188ed5f688c641784f0b19eaeafdf444ea38"
    "FlsHook.exe|8203ed25c7007eaee9a69a45b3255c99ef607287f0a64dbccd0ba4bec8ad9a74"
    "platform.ini|2ae7faa58a658545c5093b4c53cd89445f2a84fd8a0aa981e7519bc569aa8a8d")
    string(REPLACE "|" ";" _parts "${_pin}")
    list(GET _parts 0 _name)
    list(GET _parts 1 _expected)
    file(SHA256 "${_insyde}/${_name}" _actual)
    if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "Reviewed Insyde read component changed: ${_name}")
    endif()
endforeach()
file(GLOB _insyde_all RELATIVE "${_insyde}" "${_insyde}/*")
foreach(_name IN LISTS _insyde_all)
    if(NOT _name IN_LIST _insyde_files)
        message(FATAL_ERROR "Unexpected file in READ-ONLY Insyde runtime: ${_name}")
    endif()
endforeach()
foreach(_pin IN ITEMS "nvflash64.exe|c0620a7be0ffdad3782d9ddf238d1a19c31b587cbcfee7036819c8a50e2d89cd" "driver-1.reference.bin|79050454d06ab7b6607bca09386f704df021c3c367cc0743de6845301bb192ac" "driver-2.reference.bin|8c2d9847b70c3dc1aac5d9e5330c67deb86f369dcd3ca85845adf2a001088dde")
    string(REPLACE "|" ";" _parts "${_pin}")
    list(GET _parts 0 _name)
    list(GET _parts 1 _expected)
    file(SHA256 "${_nvflash}/${_name}" _actual)
    if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "Pinned standard NVFlash file changed: ${_name}")
    endif()
endforeach()
foreach(_pin IN ITEMS "FPTW64.exe|88491119862830235854cd29b9857de21870ac4dc16f74544b1a665f64d62807" "driver-reference.bin|acd5d366a73e9d60c654f9b6d76397d0439606939d6b0c7ee24c4f397452899a")
    string(REPLACE "|" ";" _parts "${_pin}")
    list(GET _parts 0 _name)
    list(GET _parts 1 _expected)
    file(SHA256 "${_fpt19}/${_name}" _actual)
    if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "Original embedded Intel FPT19 file changed: ${_name}")
    endif()
endforeach()
foreach(_pin IN ITEMS "FPTW64.exe|41fa119d68f15dc567df37d9513f433507680a6cdea200ac0cdff9cc88c68aae" "driver-reference.bin|33abb3e6d36a101c89096d8d30173c79a9efe84f7780fc701fab35e398ac58b2")
    string(REPLACE "|" ";" _parts "${_pin}")
    list(GET _parts 0 _name)
    list(GET _parts 1 _expected)
    file(SHA256 "${_fpt}/${_name}" _actual)
    if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "Original embedded Intel FPT file changed: ${_name}")
    endif()
endforeach()
foreach(_pin IN ITEMS "AFUWINx64.exe|535633b1c097581f34d31c3e2b9c594779c6e88dfd52cf3c02ac72c1b3e6649b" "amigendrv64.sys|4892914632d4a8c327e6963b8a841266d6cdc466af03603b99d486799d947b64")
    string(REPLACE "|" ";" _parts "${_pin}")
    list(GET _parts 0 _name)
    list(GET _parts 1 _expected)
    file(SHA256 "${_ami}/${_name}" _actual)
    if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "Original embedded AMI file changed: ${_name}")
    endif()
endforeach()
magiccontrol_validate_pawnio("${_pawn}")
magiccontrol_validate_uniwill("${_uniwill}")
file(SHA256 "${_pawn}/PawnIO_setup.exe" _setup_hash)
if(NOT _setup_hash STREQUAL "1f519a22e47187f70a1379a48ca604981c4fcf694f4e65b734aaa74a9fba3032")
    message(FATAL_ERROR "Embedded PawnIO2.2.0 installer SHA256 mismatch")
endif()
magiccontrol_uniwill_files("${_uniwill}" _uniwill_files)
set(_resource_id 1000)
set(_rc "// Generated from the reviewed runtime catalogues; original bytes.\n")
set(_header "#pragma once\n#include <array>\n#include <string_view>\n#include <cstddef>\nnamespace mc::windows::embedded {\nstruct ResourceEntry { unsigned id; std::string_view group,name,sha256; std::size_t bytes; };\ninline constexpr auto files=std::to_array<ResourceEntry>({\n")
set(_identity)
set(_payloads)
foreach(_group IN ITEMS PawnIO Uniwill Installers AmiAfu IntelFpt IntelFpt19 NvFlash InsydeH2offt LenovoEnergy)
    if(_group STREQUAL "PawnIO")
        set(_base "${_pawn}")
        set(_files ${MAGICCONTROL_PAWNIO_REQUIRED_FILES})
    elseif(_group STREQUAL "Uniwill")
        set(_base "${_uniwill}")
        set(_files ${_uniwill_files})
    elseif(_group STREQUAL "AmiAfu")
        set(_base "${_ami}")
        set(_files AFUWINx64.exe amigendrv64.sys readme.txt LICENSE.txt PROVENANCE.json)
    elseif(_group STREQUAL "IntelFpt")
        set(_base "${_fpt}")
        set(_files FPTW64.exe driver-reference.bin NOTICE.txt PROVENANCE.json)
    elseif(_group STREQUAL "IntelFpt19")
        set(_base "${_fpt19}")
        set(_files FPTW64.exe driver-reference.bin NOTICE.txt PROVENANCE.json)
    elseif(_group STREQUAL "NvFlash")
        set(_base "${_nvflash}")
        set(_files nvflash64.exe driver-1.reference.bin driver-2.reference.bin NOTICE.txt THIRD-PARTY-NOTICES.txt PROVENANCE.json)
    elseif(_group STREQUAL "InsydeH2offt")
        set(_base "${_insyde}")
        set(_files ${_insyde_files})
    elseif(_group STREQUAL "LenovoEnergy")
        set(_base "${_lenovo_energy}")
        set(_files LenovoEnergySetup.exe NOTICE.txt)
    else()
        set(_base "${_pawn}")
        set(_files PawnIO_setup.exe PawnIO-Setup-NOTICE.txt)
    endif()
    foreach(_name IN LISTS _files)
        set(_path "${_base}/${_name}")
        file(SHA256 "${_path}" _sha)
        file(SIZE "${_path}" _size)
        string(APPEND _rc "${_resource_id} RCDATA \"${_path}\"\n")
        string(APPEND _header "    {${_resource_id},\"${_group}\",\"${_name}\",\"${_sha}\",${_size}},\n")
        string(APPEND _identity "${_group}/${_name}:${_sha}\n")
        list(APPEND _payloads "${_path}")
        math(EXPR _resource_id "${_resource_id}+1")
    endforeach()
endforeach()
string(SHA256 _bundle_hash "${_identity}")
string(APPEND _header "});\ninline constexpr std::string_view bundleHash=\"${_bundle_hash}\";\n}\n")
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/generated/MagicControl/EmbeddedRuntimeCatalog.h" CONTENT "${_header}" @ONLY)
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/generated/MagicControl/EmbeddedRuntime.rc" CONTENT "${_rc}" @ONLY)
set_property(GLOBAL PROPERTY MAGICCONTROL_EMBEDDED_PAYLOADS "${_payloads}")
function(magiccontrol_embed_runtime target)
    set(_resource "${CMAKE_BINARY_DIR}/generated/MagicControl/EmbeddedRuntime.rc")
    get_property(_payloads GLOBAL PROPERTY MAGICCONTROL_EMBEDDED_PAYLOADS)
    set_property(SOURCE "${_resource}" APPEND PROPERTY OBJECT_DEPENDS ${_payloads})
    target_sources(${target} PRIVATE "${_resource}")
endfunction()
