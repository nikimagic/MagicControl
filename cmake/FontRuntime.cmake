# One private font runtime for both frontends. Never install into the OS.
function(magiccontrol_stage_fonts destination)
    set(_fonts "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/gui/assets/fonts")
    foreach(_font IN ITEMS NotoSansSC NotoSansTC)
        if(_font STREQUAL "NotoSansSC")
            set(_expected "a3041811a78c361b1de50f953c805e0244951c21c5bd412f7232ef0d899af0da")
        else()
            set(_expected "864727d210d54f2537bbe23b3a839436c3992af72de9322af5270897246bd44f")
        endif()
        if(NOT EXISTS "${_fonts}/${_font}.ttf" OR NOT EXISTS "${_fonts}/OFL-${_font}.txt")
            message(FATAL_ERROR "Private UI font or license missing: ${_font}")
        endif()
        file(SHA256 "${_fonts}/${_font}.ttf" _actual)
        if(NOT _actual STREQUAL _expected)
            message(FATAL_ERROR "Private UI font SHA256 mismatch: ${_font}")
        endif()
    endforeach()
    file(MAKE_DIRECTORY "${destination}/fonts")
    file(COPY "${_fonts}/" DESTINATION "${destination}/fonts")
endfunction()
