# Debug binaries must never overwrite the portable Linux package.
if(NOT CONFIG STREQUAL "Release")
    message(STATUS "Portable Linux package is updated by Release builds only")
    return()
endif()

if(NOT DEFINED DESTINATION)
    message(FATAL_ERROR "Portable Linux staging requires a destination")
endif()

file(MAKE_DIRECTORY "${DESTINATION}")
file(MAKE_DIRECTORY "${DESTINATION}/settings")
foreach(_settings IN ITEMS fan-curves.csv app-settings.ini)
    if(NOT EXISTS "${DESTINATION}/settings/${_settings}")
        if(EXISTS "${DESTINATION}/${_settings}")
            file(COPY_FILE "${DESTINATION}/${_settings}" "${DESTINATION}/settings/${_settings}")
        else()
            file(COPY_FILE "${CMAKE_CURRENT_LIST_DIR}/../packaging/${_settings}" "${DESTINATION}/settings/${_settings}")
        endif()
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/FontRuntime.cmake")
magiccontrol_stage_fonts("${DESTINATION}")
set(_nvflash "${CMAKE_CURRENT_LIST_DIR}/../src/platform/linux/runtime/NvFlash")
file(SHA256 "${_nvflash}/nvflash" _nvflash_sha)
if(NOT _nvflash_sha STREQUAL "754693fb8f833be75601f95cb08a6e0cf538053cce84ab69020ec74ae96a6e70")
    message(FATAL_ERROR "Linux NVFlash SHA256 mismatch")
endif()
file(MAKE_DIRECTORY "${DESTINATION}/tools/NvFlash" "${DESTINATION}/licenses/NVFlash")
file(COPY_FILE "${_nvflash}/nvflash" "${DESTINATION}/tools/NvFlash/nvflash" ONLY_IF_DIFFERENT)
file(CHMOD "${DESTINATION}/tools/NvFlash/nvflash" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
foreach(_notice IN ITEMS NOTICE.txt THIRD-PARTY-NOTICES.txt PROVENANCE.json)
    file(COPY_FILE "${_nvflash}/${_notice}" "${DESTINATION}/licenses/NVFlash/${_notice}" ONLY_IF_DIFFERENT)
endforeach()

if(DEFINED GUI_EXECUTABLE)
    if(NOT EXISTS "${GUI_EXECUTABLE}")
        message(FATAL_ERROR "Portable Linux GUI executable is missing: ${GUI_EXECUTABLE}")
    endif()
    file(COPY_FILE "${GUI_EXECUTABLE}" "${DESTINATION}/MagicControl" ONLY_IF_DIFFERENT)
    file(CHMOD "${DESTINATION}/MagicControl"
        PERMISSIONS
            OWNER_READ OWNER_WRITE OWNER_EXECUTE
            GROUP_READ GROUP_EXECUTE
            WORLD_READ WORLD_EXECUTE)
    message(STATUS "Portable Linux GUI copied to ${DESTINATION}/MagicControl")
    if(DEFINED LAYER_LIBRARY AND EXISTS "${LAYER_LIBRARY}")
        file(COPY_FILE "${LAYER_LIBRARY}" "${DESTINATION}/libgtk4-layer-shell.so.0" ONLY_IF_DIFFERENT)
        if(EXISTS "/usr/share/doc/libgtk4-layer-shell0/copyright")
            file(COPY_FILE "/usr/share/doc/libgtk4-layer-shell0/copyright"
                "${DESTINATION}/libgtk4-layer-shell.LICENSE.txt" ONLY_IF_DIFFERENT)
        endif()
    endif()
endif()

if(DEFINED CLI_EXECUTABLE)
    if(NOT EXISTS "${CLI_EXECUTABLE}")
        message(FATAL_ERROR "Portable CLI is missing: ${CLI_EXECUTABLE}")
    endif()
    file(COPY_FILE "${CLI_EXECUTABLE}" "${DESTINATION}/mctl" ONLY_IF_DIFFERENT)
    file(CHMOD "${DESTINATION}/mctl" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
endif()
if(NOT DEFINED GUI_EXECUTABLE)
    message(FATAL_ERROR "Portable Linux staging requires the GUI executable")
endif()
# Optional sidecar is copied only after a successful build by the staging target.
if(DEFINED VERSION_FILE AND EXISTS "${VERSION_FILE}")
    file(MAKE_DIRECTORY "${DESTINATION}")
    file(COPY_FILE "${VERSION_FILE}" "${DESTINATION}/build-version.txt" ONLY_IF_DIFFERENT)
endif()
if(DEFINED DESTINATION)
    file(MAKE_DIRECTORY "${DESTINATION}/licenses")
    file(COPY_FILE "${CMAKE_CURRENT_LIST_DIR}/../packaging/linux/licenses/DRM-UAPI-NOTICES.txt" "${DESTINATION}/licenses/DRM-UAPI-NOTICES.txt" ONLY_IF_DIFFERENT)
endif()
