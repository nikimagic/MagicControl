include("${CMAKE_CURRENT_LIST_DIR}/PawnIORuntime.cmake")
if(NOT DEFINED PAWNIO_RUNTIME OR NOT DEFINED DESTINATION)
    message(FATAL_ERROR "PawnIO staging requires source and destination directories")
endif()
magiccontrol_validate_pawnio("${PAWNIO_RUNTIME}")
file(MAKE_DIRECTORY "${DESTINATION}")
foreach(_file IN LISTS MAGICCONTROL_PAWNIO_REQUIRED_FILES)
    file(COPY_FILE "${PAWNIO_RUNTIME}/${_file}" "${DESTINATION}/${_file}" ONLY_IF_DIFFERENT)
endforeach()
