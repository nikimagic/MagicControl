if(NOT DEFINED SOURCE_DIR OR NOT DEFINED BINARY_DIR OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "SOURCE_DIR, BINARY_DIR and OUTPUT are required")
endif()

set(_files)
foreach(_entry IN ITEMS src tests cmake docs assets Tools CMakeLists.txt README.md .gitattributes .gitignore)
    set(_path "${SOURCE_DIR}/${_entry}")
    if(IS_DIRECTORY "${_path}")
        file(GLOB_RECURSE _found LIST_DIRECTORIES false "${_path}/*")
        list(APPEND _files ${_found})
    elseif(EXISTS "${_path}")
        list(APPEND _files "${_path}")
    endif()
endforeach()
list(SORT _files)
file(GLOB _binaries LIST_DIRECTORIES false
    "${BINARY_DIR}/*.exe" "${BINARY_DIR}/*.dll" "${BINARY_DIR}/*.so" "${BINARY_DIR}/*")
foreach(_binary IN LISTS _binaries)
    if(NOT IS_DIRECTORY "${_binary}" AND NOT "${_binary}" MATCHES "artifact-manifest[.]json$" AND NOT "${_binary}" MATCHES "/mctl([.]exe)?$")
        list(APPEND _files "${_binary}")
    endif()
endforeach()

file(WRITE "${OUTPUT}" "{\n  \"algorithm\": \"SHA-256\",\n  \"files\": [\n")
list(LENGTH _files _count)
set(_index 0)
foreach(_file IN LISTS _files)
    file(SHA256 "${_file}" _hash)
    set(_is_source FALSE)
    foreach(_source_root IN ITEMS src tests cmake docs assets Tools)
        if("${_file}" MATCHES "^${SOURCE_DIR}/${_source_root}(/|$)")
            set(_is_source TRUE)
        endif()
    endforeach()
    foreach(_source_file IN ITEMS CMakeLists.txt README.md .gitattributes .gitignore)
        if("${_file}" STREQUAL "${SOURCE_DIR}/${_source_file}")
            set(_is_source TRUE)
        endif()
    endforeach()
    if(_is_source)
        file(RELATIVE_PATH _relative "${SOURCE_DIR}" "${_file}")
    else()
        file(RELATIVE_PATH _relative "${BINARY_DIR}" "${_file}")
        set(_relative "build/${_relative}")
    endif()
    string(REPLACE "\\" "/" _relative "${_relative}")
    math(EXPR _index "${_index} + 1")
    if(_index LESS _count)
        set(_comma ",")
    else()
        set(_comma "")
    endif()
    file(APPEND "${OUTPUT}" "    { \"path\": \"${_relative}\", \"sha256\": \"${_hash}\" }${_comma}\n")
endforeach()
file(APPEND "${OUTPUT}" "  ]\n}\n")
