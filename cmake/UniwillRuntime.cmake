# One package catalogue for embedded payloads, portable staging and releases.
# These are separate reviewed OEM packages, never a universal driver upgrade.
include_guard(GLOBAL)

function(magiccontrol_uniwill_files directory output)
    file(READ "${directory}/PACKAGES.json" _catalogue)
    string(JSON _count LENGTH "${_catalogue}" packages)
    if(_count LESS 1)
        message(FATAL_ERROR "Uniwill package catalogue is empty")
    endif()
    math(EXPR _last "${_count}-1")
    set(_files PACKAGES.json)
    foreach(_index RANGE 0 ${_last})
        string(JSON _subdir GET "${_catalogue}" packages ${_index} directory)
        if(IS_ABSOLUTE "${_subdir}" OR _subdir MATCHES "(^|/)\\.\\.(/|$)" OR _subdir MATCHES "[\\\\;]")
            message(FATAL_ERROR "Invalid Uniwill package directory")
        endif()
        foreach(_leaf IN ITEMS UWACPIDriver.sys UWACPIDriver.inf UWACPIDriver.cat README.txt PROVENANCE.json)
            if(_subdir STREQUAL ".")
                list(APPEND _files "${_leaf}")
            else()
                list(APPEND _files "${_subdir}/${_leaf}")
            endif()
        endforeach()
    endforeach()
    set(${output} "${_files}" PARENT_SCOPE)
endfunction()

function(magiccontrol_validate_uniwill directory)
    magiccontrol_uniwill_files("${directory}" _files)
    foreach(_file IN LISTS _files)
        if(NOT EXISTS "${directory}/${_file}")
            message(FATAL_ERROR "Uniwill package is missing ${_file}")
        endif()
    endforeach()
    file(READ "${directory}/PACKAGES.json" _catalogue)
    string(JSON _count LENGTH "${_catalogue}" packages)
    math(EXPR _last "${_count}-1")
    foreach(_index RANGE 0 ${_last})
        string(JSON _subdir GET "${_catalogue}" packages ${_index} directory)
        string(JSON _version GET "${_catalogue}" packages ${_index} inf_version)
        string(JSON _sys_pin GET "${_catalogue}" packages ${_index} sys_sha256)
        set(_root "${directory}/${_subdir}")
        file(READ "${_root}/PROVENANCE.json" _provenance)
        string(JSON _file_count LENGTH "${_provenance}" files)
        string(JSON _provenance_version GET "${_provenance}" inf_version)
        if(NOT _file_count EQUAL 3 OR NOT _provenance_version STREQUAL _version)
            message(FATAL_ERROR "Uniwill package provenance/version mismatch: ${_subdir}")
        endif()
        set(_seen)
        foreach(_entry RANGE 0 2)
            string(JSON _name GET "${_provenance}" files ${_entry} path)
            string(JSON _expected GET "${_provenance}" files ${_entry} sha256)
            string(JSON _size GET "${_provenance}" files ${_entry} bytes)
            list(FIND _seen "${_name}" _already_seen)
            if(NOT _name MATCHES "^UWACPIDriver\\.(sys|inf|cat)$" OR NOT _already_seen EQUAL -1)
                message(FATAL_ERROR "Invalid Uniwill package member: ${_name}")
            endif()
            list(APPEND _seen "${_name}")
            file(SHA256 "${_root}/${_name}" _actual)
            file(SIZE "${_root}/${_name}" _actual_size)
            if(NOT _actual STREQUAL _expected OR NOT _actual_size EQUAL _size)
                message(FATAL_ERROR "Uniwill original file changed: ${_subdir}/${_name}")
            endif()
        endforeach()
        file(SHA256 "${_root}/UWACPIDriver.sys" _sys_actual)
        if(NOT _sys_actual STREQUAL _sys_pin)
            message(FATAL_ERROR "Uniwill SYS differs from reviewed package pin: ${_subdir}")
        endif()
        file(READ "${_root}/UWACPIDriver.inf" _inf)
        string(FIND "${_inf}" ",${_version}" _version_at)
        string(FIND "${_inf}" "ACPI\\INOU0000" _hwid_at)
        if(_version_at LESS 0 OR _hwid_at LESS 0)
            message(FATAL_ERROR "Uniwill INF does not match catalogue: ${_subdir}")
        endif()
    endforeach()
endfunction()

function(magiccontrol_stage_uniwill directory destination)
    magiccontrol_validate_uniwill("${directory}")
    magiccontrol_uniwill_files("${directory}" _files)
    foreach(_file IN LISTS _files)
        get_filename_component(_parent "${destination}/${_file}" DIRECTORY)
        file(MAKE_DIRECTORY "${_parent}")
        file(COPY_FILE "${directory}/${_file}" "${destination}/${_file}" ONLY_IF_DIFFERENT)
    endforeach()
endfunction()
