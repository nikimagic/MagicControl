# Debug binaries must never overwrite the portable Release package.
if(NOT CONFIG STREQUAL "Release")
    message(STATUS "Portable Windows package is updated by Release builds only")
    return()
endif()
if(NOT EXISTS "${EXECUTABLE}" OR NOT DEFINED DESTINATION)
    message(FATAL_ERROR "Portable staging requires an existing executable and destination")
endif()
if(NOT DEFINED PAWNIO_RUNTIME)
    message(FATAL_ERROR "PawnIO monitoring runtime directory is missing")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/PawnIORuntime.cmake")
magiccontrol_validate_pawnio("${PAWNIO_RUNTIME}")
include("${CMAKE_CURRENT_LIST_DIR}/UniwillRuntime.cmake")
set(_uniwill_runtime "${CMAKE_CURRENT_LIST_DIR}/../src/platform/windows/runtime/Uniwill")
magiccontrol_validate_uniwill("${_uniwill_runtime}")
file(MAKE_DIRECTORY "${DESTINATION}")
# One complete owner-provided CSV for every model/OS. Existing user edits stay.
file(MAKE_DIRECTORY "${DESTINATION}/settings")
foreach(_settings IN ITEMS fan-curves.csv app-settings.ini)
    if(NOT EXISTS "${DESTINATION}/settings/${_settings}")
        if(EXISTS "${DESTINATION}/${_settings}")
            file(COPY_FILE "${DESTINATION}/${_settings}" "${DESTINATION}/settings/${_settings}")
        else()
            file(COPY_FILE "${CMAKE_CURRENT_LIST_DIR}/../packaging/${_settings}" "${DESTINATION}/settings/${_settings}")
        endif()
    endif()
endforeach()
file(MAKE_DIRECTORY "${DESTINATION}/licenses")
file(COPY_FILE "${CMAKE_CURRENT_LIST_DIR}/../packaging/windows/licenses/ADLX-SDK-LICENSE.txt" "${DESTINATION}/licenses/ADLX-SDK-LICENSE.txt" ONLY_IF_DIFFERENT)
file(COPY_FILE "${CMAKE_CURRENT_LIST_DIR}/../packaging/windows/licenses/IGCL-SDK-LICENSE.txt" "${DESTINATION}/licenses/IGCL-SDK-LICENSE.txt" ONLY_IF_DIFFERENT)
file(COPY_FILE "${EXECUTABLE}" "${DESTINATION}/MagicControl.exe" ONLY_IF_DIFFERENT)
if(DEFINED CLI_EXECUTABLE)
    if(NOT EXISTS "${CLI_EXECUTABLE}")
        message(FATAL_ERROR "Portable CLI is missing: ${CLI_EXECUTABLE}")
    endif()
    file(COPY_FILE "${CLI_EXECUTABLE}" "${DESTINATION}/mctl.exe" ONLY_IF_DIFFERENT)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/FontRuntime.cmake")
magiccontrol_stage_fonts("${DESTINATION}")
if(STATIC_CRT)
    # Generated copies from older /MD builds only; do not sweep arbitrary DLLs
    # or touch the user's settings, logs and other portable files.
    foreach(_old_crt IN ITEMS concrt140.dll msvcp140.dll msvcp140_1.dll msvcp140_2.dll
            msvcp140_atomic_wait.dll msvcp140_codecvt_ids.dll vcruntime140.dll vcruntime140_1.dll)
        file(REMOVE "${DESTINATION}/${_old_crt}")
    endforeach()
endif()
# Notices remain readable as documents; binary dependencies live in EXE resources.
file(MAKE_DIRECTORY "${DESTINATION}/licenses/PawnIO")
foreach(_pawnio_file IN LISTS MAGICCONTROL_PAWNIO_REQUIRED_FILES)
    if(_pawnio_file STREQUAL "COPYING" OR _pawnio_file MATCHES "-NOTICE\\.txt$")
        file(COPY_FILE "${PAWNIO_RUNTIME}/${_pawnio_file}" "${DESTINATION}/licenses/PawnIO/${_pawnio_file}" ONLY_IF_DIFFERENT)
    endif()
endforeach()
file(COPY_FILE "${PAWNIO_RUNTIME}/PawnIO-Setup-NOTICE.txt" "${DESTINATION}/licenses/PawnIO/PawnIO-Setup-NOTICE.txt" ONLY_IF_DIFFERENT)
include("${CMAKE_CURRENT_LIST_DIR}/RemoveLooseRuntime.cmake")
magiccontrol_remove_loose_runtime("${DESTINATION}")
get_filename_component(_build_directory "${EXECUTABLE}" DIRECTORY)
magiccontrol_remove_loose_runtime("${_build_directory}")
if(DEFINED VERSION_FILE AND EXISTS "${VERSION_FILE}")
    file(COPY_FILE "${VERSION_FILE}" "${DESTINATION}/build-version.txt" ONLY_IF_DIFFERENT)
endif()
message(STATUS "Portable Windows EXE and runtime copied to ${DESTINATION}")
file(MAKE_DIRECTORY "${DESTINATION}/licenses/NVFlash")
foreach(_notice IN ITEMS NOTICE.txt THIRD-PARTY-NOTICES.txt PROVENANCE.json)
    file(COPY_FILE "${CMAKE_CURRENT_LIST_DIR}/../src/platform/windows/runtime/NvFlash/${_notice}" "${DESTINATION}/licenses/NVFlash/${_notice}" ONLY_IF_DIFFERENT)
endforeach()

file(MAKE_DIRECTORY "${DESTINATION}/licenses/AMI-AFU")
foreach(_notice IN ITEMS LICENSE.txt readme.txt PROVENANCE.json)
    file(COPY_FILE "${CMAKE_CURRENT_LIST_DIR}/../src/platform/windows/runtime/AmiAfu/${_notice}" "${DESTINATION}/licenses/AMI-AFU/${_notice}" ONLY_IF_DIFFERENT)
endforeach()
file(MAKE_DIRECTORY "${DESTINATION}/licenses/Intel-FPT")
foreach(_notice IN ITEMS NOTICE.txt PROVENANCE.json)
    file(COPY_FILE "${CMAKE_CURRENT_LIST_DIR}/../src/platform/windows/runtime/IntelFpt/${_notice}" "${DESTINATION}/licenses/Intel-FPT/${_notice}" ONLY_IF_DIFFERENT)
endforeach()
file(MAKE_DIRECTORY "${DESTINATION}/licenses/Intel-FPT19")
file(MAKE_DIRECTORY "${DESTINATION}/licenses/Insyde-H2OFFT")
foreach(_notice NOTICE.txt PROVENANCE.json)
    file(COPY_FILE "${CMAKE_CURRENT_LIST_DIR}/../src/platform/windows/runtime/InsydeH2offt/${_notice}" "${DESTINATION}/licenses/Insyde-H2OFFT/${_notice}" ONLY_IF_DIFFERENT)
endforeach()
foreach(_notice IN ITEMS NOTICE.txt PROVENANCE.json)
    file(COPY_FILE "${CMAKE_CURRENT_LIST_DIR}/../src/platform/windows/runtime/IntelFpt19/${_notice}" "${DESTINATION}/licenses/Intel-FPT19/${_notice}" ONLY_IF_DIFFERENT)
endforeach()
