# Remove only known, generated runtime members after the new EXE is staged.
# Unknown files and user configuration are never recursively swept.
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/PawnIORuntime.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/UniwillRuntime.cmake")
function(magiccontrol_remove_loose_runtime destination)
    get_filename_component(_root "${destination}" ABSOLUTE)
    get_filename_component(_project "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    cmake_path(IS_PREFIX _project "${_root}" NORMALIZE _inside)
    if(NOT _inside OR NOT EXISTS "${_root}/MagicControl.exe")
        message(FATAL_ERROR "Loose runtime cleanup requires an application directory inside this workspace")
    endif()
    magiccontrol_uniwill_files("${_project}/src/platform/windows/runtime/Uniwill" _uniwill)
    set(_paths)
    foreach(_file IN LISTS MAGICCONTROL_PAWNIO_REQUIRED_FILES)
        list(APPEND _paths "PawnIO/${_file}")
    endforeach()
    foreach(_file IN LISTS _uniwill)
        list(APPEND _paths "drivers/Uniwill/${_file}")
    endforeach()
    foreach(_subdir IN ITEMS PawnIO drivers drivers/Uniwill drivers/Uniwill/11.2.18.347)
        if(IS_SYMLINK "${_root}/${_subdir}")
            message(FATAL_ERROR "Refusing runtime cleanup through a link: ${_root}/${_subdir}")
        endif()
    endforeach()
    foreach(_file IN LISTS _paths)
        file(REMOVE "${_root}/${_file}")
    endforeach()
    foreach(_subdir IN ITEMS PawnIO drivers/Uniwill/11.2.18.347 drivers/Uniwill drivers)
        get_filename_component(_target "${_root}/${_subdir}" ABSOLUTE)
        cmake_path(IS_PREFIX _root "${_target}" NORMALIZE _safe)
        if(NOT _safe)
            message(FATAL_ERROR "Runtime cleanup path escaped application directory")
        endif()
        file(GLOB _remaining LIST_DIRECTORIES TRUE "${_target}/*" "${_target}/.*")
        if(NOT _remaining)
            file(REMOVE_RECURSE "${_target}") # Verified empty and under the explicit application root.
        else()
            message(WARNING "Preserved unknown files in old runtime directory: ${_target}")
        endif()
    endforeach()
endfunction()
