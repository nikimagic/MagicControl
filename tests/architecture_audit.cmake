    endif()
    if(source MATCHES "#[ ]*include[^\n]*archive/")
        message(FATAL_ERROR "Product includes test/reference archive: ${path}")
    endif()
    if(path MATCHES "^src/(gui|cli)/" AND source MATCHES "${raw_writers}")
        message(FATAL_ERROR "Frontend bypasses resource write entry: ${path}")
    endif()
endforeach()
