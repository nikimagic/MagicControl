# CPU/APU: one frontend/lifecycle entry. Private model replay and physical OEM
# whole-profile commands keep the same owner and journal; they are not aliases
# permitting new frontend writes. This extends this shared audit, not a second
# checker with a different source inventory.
function(filter_preview_power path source output)
    # Only these two typed presentation adapters have this exact local member.
    # A different receiver, a nested member, or any other file is not exempt.
    if(path STREQUAL "src/platform/linux/SettingsServicesLinux.h" OR path STREQUAL "src/platform/windows/SettingsOperationsWindows.cpp")
        string(REGEX REPLACE "(^|[^A-Za-z0-9_.>])previewState_[ \t]*\\.[ \t]*customPower[ \t]*\\(" "\\1previewState_.previewPower(" source "${source}")
    endif()
    set(${output} "${source}" PARENT_SCOPE)
endfunction()

