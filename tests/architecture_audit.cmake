# One source inventory for all post-cutover architecture checks. This audits
# source structure, not hardware identity, available features or physical I/O.
if(NOT DEFINED SOURCE_ROOT)
    message(FATAL_ERROR "SOURCE_ROOT is required")
endif()
function(load relative output)
    string(MD5 key "${relative}")
    get_property(known GLOBAL PROPERTY "source_${key}" SET)
    if(NOT known)
        file(READ "${SOURCE_ROOT}/${relative}" source)
        set_property(GLOBAL PROPERTY "source_${key}" "${source}")
    endif()
    get_property(source GLOBAL PROPERTY "source_${key}")
    set(${output} "${source}" PARENT_SCOPE)
endfunction()
function(deny relative pattern)
    load("${relative}" source)
    if(source MATCHES "${pattern}")
        message(FATAL_ERROR "Architecture boundary violation: ${relative}; ${pattern}")
    endif()
endfunction()
function(one result name)
    if(ARGC GREATER 2)
        load("${ARGV2}" source)
    else()
        set(source "${all_cpp}")
    endif()
    string(REGEX MATCHALL "${result}[ \t\r\n]+${name}\\([^;{}]*\\)[ \t\r\n]*\\{" definitions "${source}")
    list(LENGTH definitions count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "${name}: expected one definition, got ${count}")
    endif()
endfunction()
function(section relative start finish output)
    load("${relative}" source)
    string(FIND "${source}" "${start}" begin)
    if(begin LESS 0)
        message(FATAL_ERROR "Missing section ${start} in ${relative}")
    endif()
    set(length -1)
    if(NOT finish STREQUAL "")
        string(FIND "${source}" "${finish}" end)
        if(end LESS_EQUAL begin)
            message(FATAL_ERROR "Invalid section ${start} / ${finish} in ${relative}")
        endif()
        math(EXPR length "${end}-${begin}")
    endif()
    string(SUBSTRING "${source}" ${begin} ${length} body)
    set(${output} "${body}" PARENT_SCOPE)
endfunction()

