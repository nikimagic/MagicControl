# Fail closed if the exemption ever conceals a different writer-shaped call.
set(_preview_writer_pattern "(->|\\.)[ \t]*(performance|customPower)[ \t]*\\(")
filter_preview_power("src/platform/linux/SettingsServicesLinux.h" "if(preview){previewState_.customPower(4);}" _preview_filtered)
