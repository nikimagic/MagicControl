    message(FATAL_ERROR "Preview filter rejected the typed presentation call")
endif()
foreach(_unsafe IN ITEMS "ptr->customPower(4);" "obj.customPower(4);" "obj.previewState_.customPower(4);" "evilpreviewState_.customPower(4);" "previewState_.customPower(4); ptr->customPower(4);")
    filter_preview_power("src/platform/linux/SettingsServicesLinux.h" "${_unsafe}" _preview_filtered)
    if(NOT _preview_filtered MATCHES "${_preview_writer_pattern}")
        message(FATAL_ERROR "Preview filter concealed an unrelated writer: ${_unsafe}")
    endif()
endforeach()
filter_preview_power("src/platform/linux/Unrelated.h" "previewState_.customPower(4);" _preview_filtered)
if(NOT _preview_filtered MATCHES "${_preview_writer_pattern}")
    message(FATAL_ERROR "Preview exemption leaked to another file")
endif()

function(writer_only_in pattern allowed)
    foreach(path IN LISTS paths)
        if(path MATCHES "/third_party/|/runtime/")
            continue()
        endif()
        load("${path}" source)
        if(ARGC GREATER 2 AND ARGV2 STREQUAL "preview_power")
            filter_preview_power("${path}" "${source}" source)
        endif()
        list(FIND allowed "${path}" cpu_allowed_index)
        if(source MATCHES "${pattern}" AND cpu_allowed_index LESS 0)
            message(FATAL_ERROR "Writer bypasses resource entry: ${path}; ${pattern}")
        endif()
    endforeach()
endfunction()
