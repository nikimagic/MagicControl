    load("${header}" preview_header)
    if(NOT preview_header MATCHES "SettingsPreviewState[ \t]+previewState_[ \t]*;")
        message(FATAL_ERROR "Preview filter requires the typed local presentation member: ${header}")
    endif()
endforeach()
