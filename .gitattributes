# Normalise line endings so the repository stays consistent across the two
# platforms this project targets: Windows uses CRLF, Linux uses LF.
* text=auto

# Source and build files are text and get normalised on commit.
*.c      text
*.cpp    text
*.h      text
*.hpp    text
*.inc    text
*.txt    text
*.md     text
*.cmake  text
CMakeLists.txt text
*.ps1    text
*.cmd    text
*.bat    text
*.json   text
# Owner-provided ready CSV is shipped byte-for-byte to both platforms.
/packaging/fan-curves.csv -text whitespace=cr-at-eol
/packaging/app-settings.ini -text whitespace=cr-at-eol
# Preserve the upstream Debian copyright notice byte-for-byte, including spaces.
/packaging/linux/libgtk4-layer-shell.LICENSE.txt -text -whitespace
*.xml    text
*.manifest text

# Shell scripts must keep LF or they will not run on Linux.
*.sh     text eol=lf

# Windows-only scripts keep CRLF.
*.cmd    text eol=crlf
*.bat    text eol=crlf

# Binary artefacts are never normalised.
*.png    binary
*.ico    binary
*.jpg    binary
*.exe    binary
*.dll    binary
*.lib    binary
*.sys    binary
*.bin    binary
*.qm     binary
*.ttf    binary
# Keep the upstream OFL bytes, including its intentional trailing space.
**/fonts/OFL-NotoSansTC.txt -text whitespace=-blank-at-eol

# Signed portable OEM packages must retain the exact catalogue-covered bytes.
/MagicControl/windows/drivers/** -text

# Generated or third-party content.
build/   export-ignore

# Preserve extracted OEM evidence (INF/catalog hashes and obfuscated metadata).
/research/devices/hydroc-16-g2/oem-5.23.51.56/** -text

# Prepared packages must retain the bytes recorded in package-manifest.json.
/GitHub_Releases/MagicControl-0.1.67-*/** -text
/GitHub_Releases/MagicControl-0.1.69-*/** -text
/GitHub_Releases/MagicControl-0.1.90-*/** -text
/GitHub_Releases/MagicControl-0.1.102-*/** -text
/GitHub_Releases/MagicControl-0.1.105-*/** -text
# Preserve manifest-covered bytes, including upstream license whitespace/CRLF.
