#include "@CMAKE_CURRENT_SOURCE_DIR@/IconResource.h"
#include "@CMAKE_BINARY_DIR@/generated/MagicControl/Version.h"
#include <winver.h>
1 VERSIONINFO
FILEVERSION MAGICCONTROL_VERSION_MAJOR,MAGICCONTROL_VERSION_MINOR,MAGICCONTROL_VERSION_PATCH,0
PRODUCTVERSION MAGICCONTROL_VERSION_MAJOR,MAGICCONTROL_VERSION_MINOR,MAGICCONTROL_VERSION_PATCH,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "NikiMagic"
            VALUE "FileDescription", "MagicControl"
            VALUE "FileVersion", MAGICCONTROL_VERSION_STRING
            VALUE "ProductName", "MagicControl"
            VALUE "ProductVersion", MAGICCONTROL_VERSION_STRING
            VALUE "LegalCopyright", "Copyright (c) 2026 NikiMagic. All rights reserved."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
// Full-canvas background; the ribbon M retains its original dimensions.
IDI_MAGICCONTROL ICON "@PROJECT_SOURCE_DIR@/src/gui/assets/magiccontrol.ico"

IDR_DONATION_QR RCDATA "@PROJECT_SOURCE_DIR@/src/gui/assets/donation-wallet.png"

// Embed the canonical project license verbatim; no runtime file dependency.
// License SHA-256: @MAGICCONTROL_PROJECT_LICENSE_SHA256@
IDR_PROJECT_LICENSE RCDATA "@PROJECT_SOURCE_DIR@/packaging/LICENSE.txt"

// Reviewed driver/module resources are generated once by EmbeddedRuntime.cmake
// and linked into both the GUI and CLI executables.
