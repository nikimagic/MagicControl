#include "@CMAKE_BINARY_DIR@/generated/MagicControl/Version.h"
#include <winver.h>
1 VERSIONINFO
FILEVERSION MAGICCONTROL_VERSION_MAJOR,MAGICCONTROL_VERSION_MINOR,MAGICCONTROL_VERSION_PATCH,0
PRODUCTVERSION MAGICCONTROL_VERSION_MAJOR,MAGICCONTROL_VERSION_MINOR,MAGICCONTROL_VERSION_PATCH,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "NikiMagic"
   VALUE "FileDescription", "MagicControl SSH command line"
   VALUE "FileVersion", MAGICCONTROL_VERSION_STRING
   VALUE "ProductName", "MagicControl"
   VALUE "ProductVersion", MAGICCONTROL_VERSION_STRING
   VALUE "OriginalFilename", "mctl.exe"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
